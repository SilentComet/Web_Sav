# Environment Variables Template

# Server Configuration
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/websav

# Redis
REDIS_URL=redis://localhost:6379

# Security Secrets (GENERATE UNIQUE VALUES IN PRODUCTION!)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-required-here
REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-characters-here
CSRF_SECRET=your-super-secret-csrf-key-minimum-32-characters-here

# Token Configuration
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# CORS Configuration
FRONTEND_URL=http://localhost:3000
FRONTEND_DASHBOARD_URL=http://localhost:5173

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Stripe (Optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
